{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus",
  "version": "0.1.4",
  "identifier": "com.focus.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Focus",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Registro personal de hábitos y tiempo",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3N0NGMzM5MUJDNjVBQzcKUldUSFdzWWJPZk44RjFxMTYxSG5lQXJsclNZN0RyTkFWbC9sZDhia0dpcm1McTc5M1hoa2lzaFgK",
      "endpoints": [
        "https://github.com/Rosellpc/Focus/releases/latest/download/latest.json"
      ]
    }
  }
}
